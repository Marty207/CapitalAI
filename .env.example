# ── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Server-only (backend) — needed for DELETE /api/v1/account
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database — Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use Session pooler, port 5432 (works with SQLAlchemy+asyncpg). User postgres.[project-ref]. Use postgresql+asyncpg://
# If db.[ref].supabase.co fails DNS, use pooler (region must match your project, e.g. aws-0-us-east-2).
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Plaid ─────────────────────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
# Leave empty to use Plaid Dashboard "default" customization
PLAID_LINK_CUSTOMIZATION_NAME=
# Required for OAuth banks on iOS (must be a Universal Link, e.g. https://your-domain.com/plaid/)
PLAID_REDIRECT_URI=

# ── Capito — DeepSeek (https://platform.deepseek.com/api_keys) ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional OpenAI fallback instead of DeepSeek:
# OPENAI_API_KEY=

# ── Backend ───────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","exp://localhost:8081"]

# ── Web (Next.js) — copy to web/.env.local ───────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PLAID_ENV=sandbox

# ── Mobile (Expo public vars) ──────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
